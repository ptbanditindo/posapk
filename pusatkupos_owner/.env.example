# Salin menjadi .env lalu isi dengan keluaran `dart run bin/relay.dart key`.
# Nilai ini ditanam saat build, bukan dibaca saat aplikasi berjalan.
PUSATKU_LICENSE_PUBLIC_KEY=ganti-dengan-license-public-key-dari-relay
# Client ID OAuth Google (kosong = login Google nonaktif).
PUSATKU_GOOGLE_CLIENT_ID=
