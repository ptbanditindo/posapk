# Salin file ini menjadi .env lalu sesuaikan nilainya.
# .env tidak ikut di-commit.
RELAY_HOST=0.0.0.0
RELAY_PORT=8787
RELAY_DATABASE_URL=postgresql://relay:ganti-password@127.0.0.1:5432/pusatkupos_relay
RELAY_ADMIN_TOKEN=ganti-token-admin
# Client ID OAuth "Web application" dari Google Cloud Console. Kosongkan untuk
# mematikan login Google. Harus sama dengan PUSATKU_GOOGLE_CLIENT_ID di aplikasi.
RELAY_GOOGLE_CLIENT_ID=
# Origin web yang diizinkan, dipisah koma (mis. https://app.contoh.id).
# Biarkan kosong bila hanya aplikasi native yang memakai relay; browser tidak
# akan diberi izin CORS.
RELAY_ALLOWED_ORIGINS=
# Versi protokol minimum yang diterima. Protokol v2 mewajibkan key_version;
# naikkan ke 2 setelah semua perangkat memakai aplikasi terbaru.
RELAY_MIN_PROTOCOL=1
